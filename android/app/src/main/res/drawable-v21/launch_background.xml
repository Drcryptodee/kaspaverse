<?xml version="1.0" encoding="utf-8"?>
<!-- The window the OS paints before Flutter's first frame. `kv_abyss`, never
     white and never `?android:colorBackground` — this app is dark-only, so
     deferring to the platform means a light flash on a light-mode device
     (BG-1, D-247). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/kv_abyss" />
</layer-list>
