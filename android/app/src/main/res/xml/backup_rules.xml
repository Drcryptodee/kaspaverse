<?xml version="1.0" encoding="utf-8"?>
<!-- Pre-API-31 Auto Backup. allowBackup is false, so this is belt-and-suspenders
     and documents intent: the seed blobs and lockout counter are never backed
     up (vault_architecture §5; wallet-security item 2). -->
<full-backup-content>
    <exclude domain="file" path="vault.kvsb"/>
    <exclude domain="file" path="vault.keystore.blob"/>
    <exclude domain="file" path="vault.lockout"/>
</full-backup-content>
